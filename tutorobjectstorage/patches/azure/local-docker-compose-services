{% if OBJSTORAGE_BACKEND == "azure" and OBJSTORAGE_AZURE_ACKNOWLEDGE_RISK %}
# rclone (https://rclone.org) as an S3-to-Azure-Blob-Storage gateway.
#
# Two `rclone serve s3` processes share one Azure Blob Storage account:
# `rclonegw` requires credentials and can read/write every bucket.
# `rclonegw-public` has no credentials at all, is `--read-only`, and is
# scoped with `--include` to only the bucket(s) that must be anonymously
# readable (forum image uploads are rendered as plain <img> tags baked
# permanently into stored post HTML, so presigned URLs don't work for
# them — they would eventually expire). The `caddyfile` patch routes
# GET/HEAD on the public bucket's path to `rclonegw-public` and everything
# else to `rclonegw`, so Open edX only ever talks to one hostname. See
# EVALUATION.md for why this two-process split exists at all: rclone's
# `serve s3` has no bucket-level ACL/policy mechanism, unlike RustFS/MinIO.
#
# `--dir-cache-time=10ms` on both: this was `=0` until EVALUATION.md
# Finding 5. `0` is not "cache disabled", it's "every directory lookup's
# cache entry is permanently and immediately expired", which drives
# rclone's VFS layer's per-directory cleanup timer to re-arm itself with
# no effective delay - confirmed via a live Go goroutine dump showing a
# storm of `vfs.(*Dir).cacheCleanup`/`ForgetAll` goroutines (all spawned by
# `time.goFunc`) contending for the same directory's mutex, pinning the
# gateway at 100%+ CPU until it stops responding to every request, not
# only the one that touched that directory - triggered by ordinary Studio
# usage (exporting a course containing a SCORM component), not adversarial
# behavior.
#
# A nonzero value fixes that, but introduces its own trade-off: for as
# long as a directory's listing stays cached, a file written by a
# *different* lookup of the same directory won't show up in it - rclone's
# own `HeadObject`/`GetObject` resolve a specific key by consulting the
# same per-directory cache the listing storm came from. `=1s` first (the
# value tried here) passed the real-world trigger five-for-five but broke
# this plugin's own live conformance suite in CI: a `PutObject` immediately
# followed by a `HeadObject`/`GetObject` for the same key - an ordinary
# write-then-read pattern, not a corner case - returned `404`/`NoSuchKey`
# for several tests. `10ms` is short enough that this didn't reproduce
# across repeated full suite runs locally, while still passing the
# original livelock trigger (the real Studio/SCORM export) on every
# attempt - still long enough to dodge the zero-duration edge case, and
# still short enough that "see buckets quickly after init" holds in
# practice.
#
# Azure containers stay fully private at the Azure IAM layer the whole
# time; nothing here ever changes a native Azure ACL — "public" is purely
# a property of this two-process topology. Unlike RustFS, no object data
# lives on local disk, so there is no bind-mounted volume, no
# non-root/chown dance, and nothing here to back up outside of Azure
# itself.
rclonegw:
  image: {{ OBJSTORAGE_AZURE_DOCKER_IMAGE }}
  user: "{{ OBJSTORAGE_AZURE_UID }}:{{ OBJSTORAGE_AZURE_GID }}"
  command:
    - serve
    - s3
    - "azureblob:"
    - --addr=:9000
    - --auth-key={{ OPENEDX_AWS_ACCESS_KEY }},{{ OPENEDX_AWS_SECRET_ACCESS_KEY }}
    - --vfs-cache-mode=off
    - --dir-cache-time=10ms
    - --multipart-streaming-buffer-limit={{ OBJSTORAGE_AZURE_MULTIPART_BUFFER_LIMIT }}
  environment:
    RCLONE_CONFIG_AZUREBLOB_TYPE: "azureblob"
    RCLONE_CONFIG_AZUREBLOB_ACCOUNT: "{{ OBJSTORAGE_AZURE_ACCOUNT }}"
    RCLONE_CONFIG_AZUREBLOB_KEY: "{{ OBJSTORAGE_AZURE_ACCOUNT_KEY }}"
    RCLONE_CONFIG_AZUREBLOB_ENDPOINT: "{{ OBJSTORAGE_AZURE_ENDPOINT }}"
  depends_on: ["azurite"]
  restart: unless-stopped

# Anonymous, read-only, scoped to the public bucket(s) only. No
# --auth-key at all: this process is reachable with zero credentials by
# design. --read-only blocks every write path at the VFS layer (object
# PUT/DELETE *and* CreateBucket/DeleteBucket). --include scopes the served
# tree so that even a caller reaching this container directly — bypassing
# Caddy's method+path routing entirely — cannot see or address any bucket
# other than the public one(s).
rclonegw-public:
  image: {{ OBJSTORAGE_AZURE_DOCKER_IMAGE }}
  user: "{{ OBJSTORAGE_AZURE_UID }}:{{ OBJSTORAGE_AZURE_GID }}"
  command:
    - serve
    - s3
    - "azureblob:"
    - --addr=:9000
    - --read-only
    - --vfs-cache-mode=off
    - --dir-cache-time=10ms
    - --include=/{{ OBJSTORAGE_BUCKET_NAME }}/**
    {% if OBJSTORAGE_DISCOVERY_BUCKET_NAME %}- --include=/{{ OBJSTORAGE_DISCOVERY_BUCKET_NAME }}/**{% endif %}
  environment:
    RCLONE_CONFIG_AZUREBLOB_TYPE: "azureblob"
    RCLONE_CONFIG_AZUREBLOB_ACCOUNT: "{{ OBJSTORAGE_AZURE_ACCOUNT }}"
    RCLONE_CONFIG_AZUREBLOB_KEY: "{{ OBJSTORAGE_AZURE_ACCOUNT_KEY }}"
    RCLONE_CONFIG_AZUREBLOB_ENDPOINT: "{{ OBJSTORAGE_AZURE_ENDPOINT }}"
  depends_on: ["azurite"]
  restart: unless-stopped

# Azurite: Microsoft's own local Azure Storage emulator. Backs the gateway
# by default so `tutor local launch` needs no real Azure account. Override
# OBJSTORAGE_AZURE_ACCOUNT / _ACCOUNT_KEY / _ENDPOINT together to point at
# real Azure instead; this service is harmless but unused in that case.
azurite:
  image: {{ OBJSTORAGE_AZURE_AZURITE_DOCKER_IMAGE }}
  command: ["azurite-blob", "--blobHost", "0.0.0.0", "--blobPort", "10000"]
  restart: unless-stopped
{% endif %}
